# Application
NODE_ENV=development
PORT=3000
APP_NAME=nodejs-pro

# Database
# Local dev: localhost | Docker compose: overridden to "postgres" via compose.yml
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=nodejs_pro

# pgAdmin (Web GUI for PostgreSQL, docker compose --profile debug)
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=admin

# JWT — change JWT_SECRET in production!
JWT_SECRET=super-secret-dev-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# S3 / RustFS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=rustfsadmin
AWS_SECRET_ACCESS_KEY=rustfsadmin
S3_BUCKET_NAME=nodejs-pro-files
# Local dev: http://localhost:9000 | Docker compose: overridden to "http://rustfs:9000"
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true

# File delivery (optional, falls back to S3_ENDPOINT)
CLOUDFRONT_BASE_URL=
